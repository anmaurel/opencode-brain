# OpenCode config — see .env.work / .env.perso-high / .env.perso-low for mode presets.
# Run: bun run switch <work|perso-high|perso-low>

OPENCODE_CONFIG_DIR=$HOME/.config/opencode
BRAIN_ROOT=$HOME/brain

OPENCODE_MODEL_DEFAULT=anthropic/claude-sonnet-4-6
OPENCODE_MODEL_SMALL=anthropic/claude-haiku-4-5
OPENCODE_MODEL_HUGE=anthropic/claude-opus-4-7

OPENCODE_ANTHROPIC_BASE_URL=http://127.0.0.1:3456
OPENCODE_ANTHROPIC_API_KEY=dummy

OPENCODE_EXTRA_PLUGIN=opencode-with-claude

BRAIN_RAG_EMBED_URL=http://localhost:1234/v1/embeddings
BRAIN_RAG_EMBED_MODEL=text-embedding-baai-bge-m3-568m
BRAIN_RAG_QDRANT_URL=http://localhost:6333
BRAIN_RAG_COLLECTION=brain_chunks
BRAIN_RAG_CHUNK_WORDS=320
BRAIN_RAG_CHUNK_OVERLAP=50
BRAIN_RAG_SEARCH_LIMIT=5
BRAIN_RAG_CONTEXT_LIMIT=3
BRAIN_RAG_RESULT_LIMIT_CAP=20
BRAIN_RAG_SEARCH_MAX_CHARS=900
BRAIN_RAG_CONTEXT_MAX_CHARS=700
BRAIN_RAG_RESULT_MAX_CHARS_CAP=5000
BRAIN_RAG_ALLOWED_PATHS=
BRAIN_RAG_REINDEX_ON_STARTUP=false
BRAIN_RAG_WATCH=true
BRAIN_RAG_REINDEX_INTERVAL_MS=0
BRAIN_RAG_WATCH_DEBOUNCE_MS=10000

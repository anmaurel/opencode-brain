OPENCODE_CONFIG_DIR=$HOME/.config/opencode
BRAIN_ROOT=$HOME/brain

OPENCODE_MODEL_DEFAULT=anthropic/claude-sonnet-4-6
OPENCODE_MODEL_SMALL=anthropic/claude-haiku-4-5
OPENCODE_MODEL_HUGE=anthropic/claude-opus-4-7

BRAIN_RAG_EMBED_URL=http://localhost:1234/v1/embeddings
BRAIN_RAG_EMBED_MODEL=text-embedding-bge-m3
BRAIN_RAG_QDRANT_URL=http://localhost:6333
BRAIN_RAG_COLLECTION=brain_chunks
BRAIN_RAG_REINDEX_ON_STARTUP=true
BRAIN_RAG_WATCH=true
BRAIN_RAG_REINDEX_INTERVAL_MS=1800000
BRAIN_RAG_WATCH_DEBOUNCE_MS=10000

{
  "$schema": "https://opencode.ai/config.json",
  "model": "$OPENCODE_MODEL_DEFAULT",
  "small_model": "$OPENCODE_MODEL_SMALL",
  "instructions": [
    "$OPENCODE_CONFIG_DIR/instructions.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": "$OPENCODE_COMPACTION_TAIL_TURNS",
    "preserve_recent_tokens": "$OPENCODE_COMPACTION_PRESERVE_TOKENS",
    "reserved": "$OPENCODE_COMPACTION_RESERVED"
  },
  "tool_output": {
    "max_lines": "$OPENCODE_TOOL_MAX_LINES",
    "max_bytes": "$OPENCODE_TOOL_MAX_BYTES"
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "brain_fs*": "deny",
    "brain_rag*": "deny"
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "$OPENCODE_ANTHROPIC_BASE_URL",
        "apiKey": "$OPENCODE_ANTHROPIC_API_KEY"
      }
    }
  },
  "mcp": {
    "brain_fs": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec npx -y @modelcontextprotocol/server-filesystem \"$BRAIN_ROOT\""
      ],
      "enabled": true,
      "timeout": 30000
    },
    "brain_rag": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "BRAIN_RAG_ROOT=\"$BRAIN_ROOT\" exec bun \"$OPENCODE_CONFIG_DIR/brain/rag/server.mjs\""
      ],
      "environment": {
        "BRAIN_RAG_EMBED_URL": "$BRAIN_RAG_EMBED_URL",
        "BRAIN_RAG_EMBED_MODEL": "$BRAIN_RAG_EMBED_MODEL",
        "BRAIN_RAG_QDRANT_URL": "$BRAIN_RAG_QDRANT_URL",
        "BRAIN_RAG_COLLECTION": "$BRAIN_RAG_COLLECTION",
        "BRAIN_RAG_CHUNK_WORDS": "$BRAIN_RAG_CHUNK_WORDS",
        "BRAIN_RAG_CHUNK_OVERLAP": "$BRAIN_RAG_CHUNK_OVERLAP",
        "BRAIN_RAG_SEARCH_LIMIT": "$BRAIN_RAG_SEARCH_LIMIT",
        "BRAIN_RAG_CONTEXT_LIMIT": "$BRAIN_RAG_CONTEXT_LIMIT",
        "BRAIN_RAG_RESULT_LIMIT_CAP": "$BRAIN_RAG_RESULT_LIMIT_CAP",
        "BRAIN_RAG_SEARCH_MAX_CHARS": "$BRAIN_RAG_SEARCH_MAX_CHARS",
        "BRAIN_RAG_CONTEXT_MAX_CHARS": "$BRAIN_RAG_CONTEXT_MAX_CHARS",
        "BRAIN_RAG_RESULT_MAX_CHARS_CAP": "$BRAIN_RAG_RESULT_MAX_CHARS_CAP",
        "BRAIN_RAG_ALLOWED_PATHS": "$BRAIN_RAG_ALLOWED_PATHS",
        "BRAIN_RAG_REINDEX_ON_STARTUP": "$BRAIN_RAG_REINDEX_ON_STARTUP",
        "BRAIN_RAG_WATCH": "$BRAIN_RAG_WATCH",
        "BRAIN_RAG_REINDEX_INTERVAL_MS": "$BRAIN_RAG_REINDEX_INTERVAL_MS",
        "BRAIN_RAG_WATCH_DEBOUNCE_MS": "$BRAIN_RAG_WATCH_DEBOUNCE_MS",
        "BRAIN_RAG_FTS5_PATH": "$BRAIN_RAG_FTS5_PATH",
        "BRAIN_MEMORY_ENABLED": "$BRAIN_MEMORY_ENABLED"
      },
      "enabled": true,
      "timeout": 60000
    }
  },
  "tools": {
    "brain_fs*": false,
    "brain_rag*": false
  },
  "agent": {
    "brain": {
      "model": "$OPENCODE_MODEL_DEFAULT",
      "prompt": "{file:$OPENCODE_CONFIG_DIR/prompts/build.md}",
      "tools": {
        "brain_fs*": true,
        "brain_rag*": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "brain_fs*": "allow",
        "brain_rag*": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "docs-writer": "allow"
        }
      }
    },
    "build": {
      "model": "$OPENCODE_MODEL_DEFAULT",
      "prompt": "{file:$OPENCODE_CONFIG_DIR/prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "debug": "allow",
          "code-reviewer": "allow",
          "tests-writer": "allow"
        }
      }
    },
    "plan": {
      "model": "$OPENCODE_MODEL_DEFAULT",
      "prompt": "{file:$OPENCODE_CONFIG_DIR/prompts/plan.md}",
      "tools": {
        "brain_fs*": true,
        "brain_rag*": true
      },
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "brain_fs*": "allow",
        "brain_rag*": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow",
          "debug": "allow",
          "code-reviewer": "allow",
          "web-researcher": "allow"
        }
      }
    },
    "code-reviewer": {
      "model": "$OPENCODE_MODEL_DEFAULT"
    },
    "debug": {
      "model": "$OPENCODE_MODEL_DEFAULT"
    },
    "security-auditor": {
      "model": "$OPENCODE_MODEL_DEFAULT"
    },
    "web-researcher": {
      "model": "$OPENCODE_MODEL_SMALL",
      "tools": {
        "webfetch": true
      }
    },
    "tdd": {
      "model": "$OPENCODE_MODEL_DEFAULT"
    },
    "tests-writer": {
      "model": "$OPENCODE_MODEL_SMALL"
    },
    "docs-writer": {
      "model": "$OPENCODE_MODEL_SMALL"
    },
    "explore": {
      "model": "$OPENCODE_MODEL_SMALL",
      "tools": {
        "brain_fs*": true,
        "brain_rag*": true
      },
      "permission": {
        "brain_fs*": "allow",
        "brain_rag*": "allow"
      }
    }
  },
  "plugin": [
    "@slkiser/opencode-quota",
    "$OPENCODE_EXTRA_PLUGIN"
  ]
}
